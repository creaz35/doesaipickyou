# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
#
# Firebase console → Project settings → General → "Your apps" → Web app config.
# These are NEXT_PUBLIC_ on purpose: Firebase web config is not secret. Access
# is controlled by Firestore security rules (see firestore.rules), not by hiding
# these keys.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional, only needed if you turn on Google Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side keys for the snapshot runner (/api/run-category). A model is
# only queried when its key is present. Never NEXT_PUBLIC_ these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides for the runner. Prefer current-generation
# models: stale-knowledge minis can't name tools launched after their
# training data, which reads as unfair zeros on the leaderboards.
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5

# Stripe secret key (dashboard → Developers → API keys) for /sponsor checkout.
# Use the sk_test_ key while testing. Never NEXT_PUBLIC_ this.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...) for /api/stripe/webhook.
# Dashboard → Developers → Webhooks → Add endpoint → checkout.session.completed.
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave blank to disable;
# when set, gtag.js loads on every page.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Transactional email via Gmail SMTP (sponsor receipts, etc.). Requires
# 2-step verification on the Google account, then create an app password:
# myaccount.google.com → Security → 2-Step Verification → App passwords.
# Receipts are CC'd to GMAIL_USER so you keep a copy. Blank = no emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=
